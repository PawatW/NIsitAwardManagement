                  Cancel
                </button>
                <button className="btn btn-primary" onClick={handleSaveEdit}>
                  <span className="btn-icon"><Check size={16} /></span>
                  Save Changes
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* History Modal */}
      {showHistoryModal && selectedUser && (
        <div className="modal-overlay" onClick={() => setShowHistoryModal(false)}>
          <div className="modal-content modal-large" onClick={(e) => e.stopPropagation()}>
            <div className="modal-header">
              <div>
                <h2 className="modal-title">Activity History</h2>
                <p className="modal-subtitle">{selectedUser.name} ({selectedUser.email})</p>
              </div>
              <button className="modal-close" onClick={() => setShowHistoryModal(false)}><X size={20} /></button>
            </div>

            <div className="history-content">
              <div className="history-timeline">
                <div className="history-item">
                  <div className="history-icon success"><Check size={16} /></div>
                  <div className="history-details">
                    <div className="history-title">Application Submitted</div>
                    <div className="history-description">Submitted application for Academic Excellence Award</div>
                    <div className="history-time">2 days ago - Jan 29, 2026 14:30</div>
                  </div>
                </div>

                <div className="history-item">
                  <div className="history-icon info">🔐</div>
                  <div className="history-details">
                    <div className="history-title">Login</div>
                    <div className="history-description">Logged in from IP: 202.44.xxx.xxx</div>
                    <div className="history-time">3 days ago - Jan 28, 2026 09:15</div>
                  </div>
                </div>

                <div className="history-item">
                  <div className="history-icon warning">⚠️</div>
                  <div className="history-details">
                    <div className="history-title">Status Changed</div>
                    <div className="history-description">Status updated to Active by Admin</div>
                    <div className="history-time">1 week ago - Jan 24, 2026 16:45</div>
                  </div>
                </div>

                <div className="history-item">
                  <div className="history-icon success"><UserIcon size={18} /></div>
                  <div className="history-details">
                    <div className="history-title">Account Created</div>
                    <div className="history-description">User account created by System Admin</div>
                    <div className="history-time">2 weeks ago - Jan 17, 2026 10:00</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Profile Modal */}
      {showProfileModal && selectedUser && (
        <div className="modal-overlay" onClick={() => setShowProfileModal(false)}>
          <div className="modal-content modal-large" onClick={(e) => e.stopPropagation()}>
            <div className="modal-header">
              <h2 className="modal-title">User Profile</h2>
              <button className="modal-close" onClick={() => setShowProfileModal(false)}><X size={20} /></button>
            </div>

            <div className="profile-content">
              {/* Profile Header */}
              <div className="profile-header">
                <div className="profile-avatar">
                  <img src={selectedUser.avatar} alt={selectedUser.name} />
                </div>
                <div className="profile-info">
                  <h3 className="profile-name">{selectedUser.name}</h3>
                  <p className="profile-email">{selectedUser.email}</p>
                  <span className={`status-badge ${selectedUser.status.toLowerCase()}`}>
                    {selectedUser.status}
                  </span>
                </div>
              </div>

              {/* Profile Details */}
              <div className="profile-details">
                <h4 className="section-title">Personal Information</h4>
                <div className="details-grid">
                  <div className="detail-item">
                    <span className="detail-label">Role</span>
                    <span className="detail-value">{selectedUser.role}</span>
                  </div>
                  <div className="detail-item">
                    <span className="detail-label">Department</span>
                    <span className="detail-value">{selectedUser.department}</span>
                  </div>
                  <div className="detail-item">
                    <span className="detail-label">Status</span>
                    <span className="detail-value">{selectedUser.status}</span>
                  </div>
                  <div className="detail-item">
                    <span className="detail-label">Joined Date</span>
                    <span className="detail-value">Jan 17, 2026</span>
                  </div>
                </div>
              </div>

              {/* Applications Section */}
              <div className="profile-section">
                <h4 className="section-title">Recent Applications</h4>
                <div className="applications-list">
                  <div className="application-item">
                    <span className="app-icon">🏆</span>
                    <div className="app-details">
                      <div className="app-name">Academic Excellence Award</div>
                      <div className="app-status pending">Pending Review</div>
                    </div>
                    <div className="app-date">Jan 29, 2026</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Settings Modal */}
      {showSettingsModal && (
        <div className="modal-overlay" onClick={() => setShowSettingsModal(false)}>
          <div className="modal-content settings-modal" onClick={(e) => e.stopPropagation()}>
            <div className="modal-header">
              <h2 className="modal-title">Table Settings</h2>
              <button className="modal-close" onClick={() => setShowSettingsModal(false)}><X size={20} /></button>
            </div>

            <div className="settings-content">
              <div className="settings-section">
                <h3 className="settings-title">Visible Columns</h3>
                <div className="checkbox-list">
                  <label className="checkbox-item">
                    <input type="checkbox" defaultChecked />
                    <span>User Details</span>
                  </label>
                  <label className="checkbox-item">
                    <input type="checkbox" defaultChecked />
                    <span>Role</span>
                  </label>
                  <label className="checkbox-item">
                    <input type="checkbox" defaultChecked />
                    <span>Department / Faculty</span>
                  </label>
                  <label className="checkbox-item">
                    <input type="checkbox" defaultChecked />
                    <span>Status</span>
                  </label>
                  <label className="checkbox-item">
                    <input type="checkbox" />
                    <span>Last Login</span>
                  </label>
                  <label className="checkbox-item">
                    <input type="checkbox" />
                    <span>Created Date</span>
                  </label>
                </div>
              </div>

              <div className="settings-section">
                <h3 className="settings-title">Display Options</h3>
                <div className="radio-list">
                  <label className="radio-item">
                    <input type="radio" name="rowsPerPage" defaultChecked />
                    <span>10 rows per page</span>
                  </label>
                  <label className="radio-item">
                    <input type="radio" name="rowsPerPage" />
                    <span>25 rows per page</span>
                  </label>
                  <label className="radio-item">
                    <input type="radio" name="rowsPerPage" />
                    <span>50 rows per page</span>
                  </label>
                  <label className="radio-item">
                    <input type="radio" name="rowsPerPage" />
                    <span>100 rows per page</span>
                  </label>
                </div>
              </div>
            </div>

            <div className="form-actions">
              <button className="btn btn-secondary" onClick={() => setShowSettingsModal(false)}>
                Cancel
              </button>
              <button className="btn btn-primary" onClick={() => setShowSettingsModal(false)}>
                <span className="btn-icon"><Check size={16} /></span>
                Apply Settings
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
